{
  "$schema": "https://raw.githubusercontent.com/stablyai/orca/main/docs/schemas/plugins/orca-plugin.v2.schema.json",
  "manifestVersion": 2,
  "execution": "trusted-worker",
  "id": "flow-native",
  "name": "Orca Flow",
  "publisher": "zhonghuaming",
  "license": "MIT",
  "icon": "assets/icon.png",
  "version": "2.0.0",
  "description": "中文敏捷看板、路线图与原生四角色 Bot 工作流，使用 Orca Run、依赖任务及消息协作。",
  "repository": "https://github.com/zhonghuaming/orca-flow",
  "engines": { "orca": ">=1.4.248" },
  "pluginApi": 1,
  "main": "worker/main.mjs",
  "contributes": {
    "panels": [{ "id": "flow", "title": "Orca Flow", "icon": "blocks", "entry": "src/panel.tsx", "ui": "components" }]
  },
  "capabilities": [{ "kind": "storage:own" }, { "kind": "workspace:read" }, { "kind": "workspace:write" }]
}
